# Copier vers .env et renseigner les vraies valeurs.
# En production, ces valeurs sont définies dans Railway > Variables.

# Accès complet : tableau de bord, clients, paiements, factures
ADMIN_ACCESS_PASSWORD=

# Accès commercial : page de recherche uniquement
# Laisser vide pour désactiver complètement l'accès commercial.
SALES_ACCESS_PASSWORD=

# Clé de signature des sessions Flask
SECRET_KEY=

DEBUG=false

# Clés des plateformes de paiement.
# Utilisées uniquement par les scripts d'import lancés à la main
# (import_bridge.py, import_mollie.py, refetch_stripe_names.py).
# L'application web n'en a pas besoin pour démarrer.
STRIPE_API_KEY=
STRIPE_API_KEY_SECONDARY=
MOLLIE_API_KEY=
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=

# Contrats Dropbox Sign (téléchargement des contrats signés)
DROPBOX_SIGN_API_KEY=
